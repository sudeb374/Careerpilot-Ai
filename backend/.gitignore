*.py[cod]
*$py.class
*.pyo

# ----- Distribution / packaging -----
dist/
build/
*.egg-info/
*.egg

# ----- Environment files -----
.env
.env.local
.env.*.local

# ----- Testing -----
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# ----- Ruff -----
.ruff_cache/

# ----- OS files -----
.DS_Store

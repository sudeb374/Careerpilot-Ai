# ===========================
# CareerPilot AI Backend — Environment Variables
# ===========================
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# ----- Application -----
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# ----- Database (PostgreSQL) -----
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/careerpilot

# ----- Supabase -----
SUPABASE_URL=
SUPABASE_KEY= 
SUPABASE_JWT_SECRET=
SUPABASE_SECRET_KEY=

# ----- Gemini API -----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ----- CORS -----
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ----- Security -----
SECRET_KEY=

# ----- JSearch (RapidAPI) -----
JSEARCH_API_KEY=
JSEARCH_API_HOST=jsearch.p.rapidapi.com

# ----- Scheduled Refresh (Phase 6.4) -----
SCHEDULED_REFRESH_ENABLED=false
SCHEDULED_REFRESH_INTERVAL_MINUTES=360
SCHEDULED_REFRESH_JSEARCH_ENABLED=true
SCHEDULED_REFRESH_JSEARCH_QUERY=software engineer intern
SCHEDULED_REFRESH_JSEARCH_MAX_PAGES=1
SCHEDULED_REFRESH_RSS_ENABLED=true
SCHEDULED_REFRESH_RSS_FEED_URLS=https://weworkremotely.com/categories/remote-programming-jobs.rss
SCHEDULED_REFRESH_RSS_MAX_ITEMS=15
SCHEDULED_REFRESH_AUTO_EXPIRE=true
